# Variables de entorno de ZAMMIR. Este archivo NO lleva valores reales [ADR-0010].
# Copia a .env (que git ignora) y llena los valores de tu entorno.
# Los valores de pruebas y producción viven solo en los paneles de Vercel y Supabase
# y en los secretos de GitHub Actions. Ver docs/arquitectura/ENTORNOS.md.

# --- Navegador (públicas; la seguridad la dan las políticas RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Solo servidor (NUNCA al navegador ni al repositorio) ---
# Las funciones de Supabase reciben SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY
# del propio Supabase: no se configuran a mano.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Proveedor de facturación: "simulated" o el PAC elegido [ADR-0007]
BILLING_PROVIDER=
PAC_API_URL=
PAC_API_KEY=

# --- Dirección pública del sistema (debe ser el dominio estable: los QR apuntan a él) ---
APP_PUBLIC_URL=

# --- Solo pruebas de integración (las llena `pnpm test:integracion` desde Supabase local; no pongas valores aquí) ---
ZAMMIR_TEST_SUPABASE_URL=
ZAMMIR_TEST_SUPABASE_ANON_KEY=
ZAMMIR_TEST_SUPABASE_SERVICE_KEY=
