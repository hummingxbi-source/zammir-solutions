{
  "name": "zammir",
  "private": true,
  "description": "Sistema de gestión para ZAMMIR (HummingX BI)",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check:deps": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check:env": "node scripts/check-env-example.mjs",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "dev": "pnpm --filter @zammir/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "funciones:empaquetar": "node scripts/empaquetar-core.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:concurrencia": "node scripts/repetir-concurrencia.mjs",
    "test:cobertura": "vitest run --coverage",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:integracion": "node scripts/test-integracion.mjs",
    "test:mutacion": "stryker run",
    "test:mutacion:critico": "node scripts/mutacion-critica.mjs",
    "test:zonas": "node scripts/test-zonas.mjs",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
